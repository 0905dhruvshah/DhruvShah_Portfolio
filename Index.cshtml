        .bar {height: 6px;background: rgba(255,255,255,0.1);border-radius: 10px;margin-top: 6px;overflow: hidden;}
        .bar div {height: 100%;background: linear-gradient(90deg,#38bdf8,#a855f7);border-radius: 10px;animation: growBar 1.5s ease;}        
