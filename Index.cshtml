        .secondary {border: 1px solid #38bdf8;color: #38bdf8;}        
        section {max-width: 1100px;margin: auto;            }
        h2 {color: #38bdf8;}        
        .card {background: rgba(15,23,42,0.8);padding: 20px;border-radius: 10px;margin-bottom: 20px;}
        ul {padding-left: 20px;}
        li {margin-bottom: 8px;}        
        .grid {display: grid;grid-template-columns: repeat(auto-fit,minmax(280px,1fr));gap: 20px;}        
        .stats {display: grid;grid-template-columns: repeat(auto-fit,minmax(200px,1fr));gap: 20px;}
        .stat {background: #0f172a;padding: 25px;border-radius: 10px;text-align: center;       }
        .stat h1 {background: linear-gradient(90deg,#38bdf8,#a855f7);-webkit-background-clip: text;color: transparent;}
        .logo-slider {overflow: hidden;width: 100%;position: relative;}
        .logo-track {display: flex;gap: 40px;width: max-content;animation: scroll 25s linear infinite;}            
        .logo-track img {width: 55px;opacity: 0.8;transition: 0.3s;}
        .logo-track img:hover {transform: scale(1.2);opacity: 1;}        
        @keyframes scroll {from {transform: translateX(0);}to {transform: translateX(-50%);}}
        @media(max-width:900px) {.hero {flex-direction: column;text-align: center;}}
        .about-container {display: grid;grid-template-columns: 60% 40%;gap: 30px;align-items: stretch;}
        .about-left h2 {margin-bottom: 15px;}        
        .stats-grid {display: grid;grid-template-columns: repeat(2, 1fr);gap: 15px;height: 100%;}        
        .stat {background: linear-gradient(145deg, #0f172a, #020617);padding: 25px;border-radius: 12px;text-align: center;border: 1px solid rgba(255,255,255,0.05);transition: 0.3s;}
        .stat h1 {font-size: 32px;background: linear-gradient(90deg,#38bdf8,#a855f7);-webkit-background-clip: text;color: transparent;}
        .stat p {color: #94a3b8;margin-top: 5px;}
        .stat:hover {transform: translateY(-5px);border-color: #38bdf8;}
        @media(max-width:900px) {.about-container {grid-template-columns: 1fr;}}
        .contact-desc {color: #94a3b8;margin: 10px 0 30px;max-width: 600px;line-height: 1.6;}
        .contact-items {display: flex;flex-direction: column;gap: 25px;}        
        .contact-item {display: flex;align-items: flex-start;gap: 15px;}            
        .contact-item .icon {font-size: 22px;margin-top: 3px;color: #38bdf8;}            
        .contact-item h3 {margin: 0;font-size: 16px;color: #e2e8f0;}
        .contact-item p {margin: 5px 0 0;color: #94a3b8;font-size: 14px;}            
        .contact-item a {color: #38bdf8;text-decoration: none;}
        .contact-item a:hover {text-decoration: underline;}
        .nav-link {position: relative;padding-bottom: 5px;}
        .nav-link::after {content: "";position: absolute;left: 0;bottom: 0;width: 0%;height: 2px;background: #38bdf8;transition: width 0.3s ease;}
        .nav-link:hover::after {width: 100%;}
        .nav-link.active {color: #38bdf8;}
        .nav-link.active::after {width: 100%;}
        .skills-grid {margin-top: 50px;display: grid;grid-template-columns: repeat(auto-fit, minmax(280px,1fr));gap: 25px;}
        .skill-card {background: linear-gradient(145deg,#0f172a,#020617);padding: 20px;border-radius: 14px;border: 1px solid rgba(255,255,255,0.05);transition: 0.3s;}
