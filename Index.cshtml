        nav {position: fixed;width: 100%;top: 0;background: rgba(2,6,23,0.9);backdrop-filter: blur(10px);z-index: 1000;}
        .nav-container {max-width: 1100px;margin: auto;display: flex;justify-content: space-between;padding: 15px 20px;}
